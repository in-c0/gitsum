# Gitsum Team backend (api/team/*). Copy to .env.local for `vercel dev`.
# In production set these in Vercel → Project → Settings → Environment Variables.
# Same names as the Gitsum web app (in-c0/Gitsum-Github-Repo-Analyser), so one Supabase / Stripe /
# Anthropic / Upstash setup powers both. Individuals are free everywhere; only Team is billed.

# --- Server only (never expose to a browser or the extension bundle) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
GITSUM_TEAM_SEAT_PRICE_ID=        # recurring per-seat price (default plan: $10/seat/month), billed with quantity = seats
STRIPE_WEBHOOK_SECRET=            # signing secret of the webhook endpoint pointing at /api/team/stripe-webhook
STRIPE_TEAM_WEBHOOK_SECRET=       # optional: set instead if this endpoint has its own secret while STRIPE_WEBHOOK_SECRET belongs to the web app
PUBLIC_SITE_URL=https://gitsum.vercel.app   # Checkout success/cancel redirects; also an allowed CORS origin

# Shared limits across all serverless instances (Upstash Redis via the Vercel Marketplace sets these).
# Required in production: without them /api/team/ask refuses billable calls (503) instead of running uncapped.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning
GITSUM_MODEL=claude-haiku-5-5
GITSUM_MAX_TOKENS=1200
GITSUM_TEAM_MONTHLY_PER_SEAT=1500  # team monthly AI answers = seats × this
GITSUM_RATE_PER_MINUTE=12          # burst limit per team key
GITSUM_GLOBAL_DAILY_LIMIT=20000    # hard ceiling on all AI answers per day, shared with the web app (cost guard)
GITSUM_CORS_ORIGINS=               # extra comma-separated web origins allowed to call /api/team/ask (chrome-extension://* is always allowed)
