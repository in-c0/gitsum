{
  "name": "gitsum",
  "version": "0.1.0",
  "description": "Understand any GitHub repo in seconds — Chrome extension, MCP server, Agent Skill and CLI on one engine.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gitsum": "src/cli.js"
  },
  "files": [
    "src",
    "skills",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "bench": "node bench/run.mjs",
    "test:team": "node --test tests/team-api.test.mjs",
    "build:extension": "node extension/build.mjs",
    "judge:hud": "node scripts/judge-hud.mjs && node extension/build.mjs && node scripts/check-extension-load.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/in-c0/gitsum.git"
  },
  "homepage": "https://in-c0.github.io/gitsum/",
  "keywords": [
    "github",
    "mcp",
    "claude",
    "skill",
    "chrome-extension",
    "code-search",
    "repository",
    "agent"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "d3-hierarchy": "^3.1.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "stripe": "^17.7.0"
  }
}
